# Copia este archivo como ".env" para usarlo.

# true  = datos de ejemplo guardados en el navegador (no necesita backend)
# false = usa el backend real (API REST en /api)
VITE_USE_MOCK=true

# Dirección base de la API cuando VITE_USE_MOCK=false.
# Déjala como /api si usas el proxy de abajo o si el backend sirve el frontend.
VITE_API_URL=/api

# Solo desarrollo: reenvía /api a tu backend local (ej. ASP.NET en http://localhost:5000)
# VITE_PROXY=http://localhost:5000
